function renderDraws() {

  const host =
    $('#drawCards');

  if (!host) {

    return;

  }


  const live =
    competitions.filter(
      competition =>
        competition.status ===
        'live'
    );


  if (!live.length) {

    host.innerHTML =
      '<p class="empty">' +
      'No live competitions right now.' +
      '</p>';

    return;

  }


  host.innerHTML =
    live.map(
      competition => {

        const percentage =
          competition.max > 0
            ? Math.min(
                100,
                Math.round(
                  (
                    competition.sold /
                    competition.max
                  ) * 100
                )
              )
            : 0;


        return `
          <article
            class="card"
            data-id="${escapeHtml(
              competition.id
            )}"
          >

            <div class="card-img">

              <img
