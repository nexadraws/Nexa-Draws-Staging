async function loadCompetitionsFromSupabase() {

  const {
    data,
    error
  } =
    await supabaseClient
      .from(
        'competitions'
      )
      .select('*')
      .order(
        'created_at',
        {
          ascending: false
        }
      );


  if (error) {

    console.error(
      'Supabase competitions error:',
      error
    );

    toast(
      'Could not load competitions'
    );

    return;

  }


  competitions =
    (data || [])
      .map(
        row => ({

          id:
            String(
              row.id
            ),

          title:
            row.title || '',

          price:
            Number(
              row.price || 0
            ),

          image:
            row.image_url || '',

          closes:
            row.closes_at || '',

          max:
            Number(
              row.max_entries || 0
            ),

          sold:
            Number(
              row.sold || 0
            ),

          status:
            row.status || 'live',

          description:
            row.description || '',

          skill_question:
            row.skill_question || '',

          skill_option_a:
            row.skill_option_a || '',

          skill_option_b:
            row.skill_option_b || '',

          skill_option_c:
            row.skill_option_c || ''

        })
      );


  renderDraws();

}


