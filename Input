              </p>


              <div class="bar">

                <i
                  style="width:${percentage}%"
                ></i>

              </div>


              <div class="stats">

                <b>
                  ${percentage}% sold
                </b>

                <span>
                  ${competition.sold.toLocaleString()}
                  /
                  ${competition.max.toLocaleString()}
                </span>

              </div>


